def render_optimization_process(grid, granularity, run_quantum):
    st.markdown("<div class='gn-card' style='text-align:center;'>", unsafe_allow_html=True)
    st.markdown("<div style='color:#00F0FF; font-size:18px; margin-bottom:20px;'>Initializing Solvers...</div>", unsafe_allow_html=True)
    progress_bar = st.progress(0)
    status_text = st.empty()
    
    status_text.markdown("<span style='color:#8B95A5'>Constructing QUBO model...</span>", unsafe_allow_html=True)
    time.sleep(0.3)
    progress_bar.progress(30)
    
    if run_quantum:
        status_text.markdown("<span style='color:#8B95A5'>Executing QAOA sequence...</span>", unsafe_allow_html=True)
    else:
        status_text.markdown("<span style='color:#8B95A5'>QAOA skipped...</span>", unsafe_allow_html=True)
        
    try:
        results = run_experiment(grid, "Dashboard_Run", granularity=granularity, run_qaoa=run_quantum)
        progress_bar.progress(70)
        status_text.markdown("<span style='color:#8B95A5'>Solving classical MILP reference...</span>", unsafe_allow_html=True)
        time.sleep(0.3)
        
        st.session_state.results = results
        st.session_state.app_status = "OPTIMIZATION COMPLETE"
        progress_bar.progress(100)
        status_text.markdown("<span style='color:#00F0FF'>Complete</span>", unsafe_allow_html=True)
        time.sleep(0.2)
        st.rerun()
    except Exception as e:
        st.session_state.app_status = "ERROR"
        st.error(f"Error: {str(e)}")
        st.stop()
    st.markdown("</div>", unsafe_allow_html=True)

