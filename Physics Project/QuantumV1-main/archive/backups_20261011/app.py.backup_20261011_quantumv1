def render_methodology():
    st.markdown("<div class='gn-hero-title'>Methodology</div>", unsafe_allow_html=True)
    st.markdown("<div class='gn-hero-sub'>Understanding the data flow from physical grid constraints to quantum Hamiltonian simulation.</div>", unsafe_allow_html=True)
    
    st.markdown("""
    <div class='gn-card'>
